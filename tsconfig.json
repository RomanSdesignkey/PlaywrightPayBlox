{
    "compilerOptions": {
      "target": "ESNext",
      "module": "CommonJS",
      "lib": ["ESNext", "DOM"],
      "strict": true,
      "moduleResolution": "Node",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "noEmit": true,
      "skipLibCheck": true,
      "esModuleInterop": true
    },
    "include": [
      "auth/example.ts", "gmail.ts"],  // ✅ Ensure gmail.ts is included
    "exclude": ["node_modules"]
  }
  